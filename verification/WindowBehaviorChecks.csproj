<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TransparentTwitchChatWPF\TransparentTwitchChatWPF.csproj" />
    <Resource Include="..\TransparentTwitchChatWPF\icons\*.ico" Link="icons\%(Filename)%(Extension)" />
    <Resource Include="..\TransparentTwitchChatWPF\assets\images\*.png" Link="assets\images\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
